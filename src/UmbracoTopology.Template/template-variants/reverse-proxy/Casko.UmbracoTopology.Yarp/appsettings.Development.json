{
  "ProxyDomains": {
    "Cm": "__CM_DOMAIN__",
    "Cd": "__CD_DOMAIN__"
  },
  "ReverseProxy": {
    "Routes": {
      "cm": {
        "ClusterId": "cm",
        "Match": { "Hosts": ["__CM_DOMAIN__"], "Path": "{**catch-all}" },
        "Transforms": [{ "RequestHeaderOriginalHost": true }]
      },
      "cd": {
        "ClusterId": "cd",
        "Match": { "Hosts": ["__CD_DOMAIN__"], "Path": "{**catch-all}" },
        "Transforms": [{ "RequestHeaderOriginalHost": true }]
      }
    },
    "Clusters": {
      "cm": {
        "Destinations": { "default": { "Address": "https://localhost:64101" } }
      },
      "cd": {
        "LoadBalancingPolicy": "RoundRobin",
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "Cookie",
          "AffinityKeyName": "Casko.Cd.Affinity",
          "FailurePolicy": "Redistribute"
        },
        "Destinations": {
          "subscriber-1": { "Address": "http://localhost:34101" },
          "subscriber-2": { "Address": "http://localhost:34102" }
        }
      }
    }
  }
}
