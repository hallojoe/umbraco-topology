---
import type { CatalogItem } from '../lib/catalog';

interface Props {
  items: CatalogItem[];
  dateLabel: string;
}

const { items, dateLabel } = Astro.props;
const formatter = new Intl.DateTimeFormat('en', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<ul class="content-list">
  {items.map((item) => (
    <li>
      <h3><a href={`/${item.id}/`}>{item.title}</a></h3>
      <p>{item.description}</p>
      <p class="date">{dateLabel}: <time datetime={item.date.toISOString().slice(0, 10)}>{formatter.format(item.date)}</time></p>
    </li>
  ))}
</ul>

<style>
  .content-list { list-style: none; padding: 0; display: grid; gap: 1rem; }
  .content-list li { border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; padding: 1rem; }
  .content-list h3 { margin: 0 0 0.5rem; }
  .content-list p { margin: 0.35rem 0; }
  .content-list .date { color: var(--sl-color-gray-2); font-size: 0.9rem; }
</style>
