{
  "ProxyDomains": {
    "Cm": "cm.dev.localhost",
    "Cd": "cd.dev.localhost"
  },
  "ReverseProxy": {
    "Routes": {
      "cm": {
        "ClusterId": "cm",
        "Match": {
          "Hosts": [
            "cm.dev.localhost"
          ],
          "Path": "{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": true
          }
        ]
      },
      "cd": {
        "ClusterId": "cd",
        "Match": {
          "Hosts": [
            "cd.dev.localhost"
          ],
          "Path": "{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": true
          }
        ]
      }
    },
    "Clusters": {
      "cm": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:64222/"
          }
        }
      },
      "cd": {
        "LoadBalancingPolicy": "RoundRobin",
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "Cookie",
          "AffinityKeyName": "Casko.Cd.Affinity",
          "FailurePolicy": "Redistribute"
        },
        "Destinations": {
          "subscriber-1": {
            "Address": "http://localhost:34366/"
          },
          "subscriber-2": {
            "Address": "http://localhost:35982/"
          }
        }
      }
    }
  }
}
